        {
          "expr": "100 * (1 - node_filesystem_files_free{job=\"node_exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_files{job=\"node_exporter\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
