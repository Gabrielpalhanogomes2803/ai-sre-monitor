      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 7
      },
      "targets": [
        {
          "expr": "100 * node_filefd_allocated{job=\"node_exporter\"} / node_filefd_maximum{job=\"node_exporter\"}",
